# Skopiuj do .env i uzupełnij.
#
# UWAGA: aplikacja nie wczytuje pliku .env sama (brak dotenv). Na produkcji
# zmienne podaje systemd przez EnvironmentFile (patrz DEPLOY.md). Lokalnie
# uruchom np.:  node --env-file=.env ...  albo wyeksportuj zmienne w powłoce.

# Serwer
NODE_ENV=development
PORT=3000
BASE_PATH=/
# Port API używany przez proxy Vite w trybie deweloperskim
API_PORT=3001
LOG_LEVEL=info

# Baza danych — bez tego aplikacja wpada w awaryjny tryb PGlite (katalog .data/)
DATABASE_URL=postgres://user:password@localhost:5432/persona

# Model czatu (OpenRouter) — wymagane, żeby konsultant odpowiadał
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic (opcjonalne, obecnie nieużywane przez trasy czatu)
ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Powiadomienia e-mail o leadach (opcjonalne)
LEAD_EMAIL=
COMPANY_NAME=Lead Catcher
RESEND_API_KEY=
LEAD_EMAIL_FROM=onboarding@resend.dev
