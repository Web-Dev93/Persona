# Persona — environment for the systemd service.
#
#   sudo mkdir -p /etc/persona
#   sudo cp deploy/persona.env.example /etc/persona/persona.env
#   sudo chown root:persona /etc/persona/persona.env && sudo chmod 640 /etc/persona/persona.env
#
# Keep this file outside the checkout: a deploy replaces the code, never the secrets.

NODE_ENV=production
PORT=3001

# Database. With DATABASE_URL set the app uses PostgreSQL; leave it empty and it
# falls back to an embedded database in PGLITE_DATA_DIR — fine for a small site,
# but PostgreSQL is the better choice on a real server.
DATABASE_URL=postgres://persona:CHANGE_ME@127.0.0.1:5432/persona

# Runtime state, deliberately outside /var/www so deploys never touch it.
PGLITE_DATA_DIR=/var/lib/persona/pgdata
UPLOAD_DIR=/var/lib/persona/uploads

# Required — the advisor cannot answer without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Lead delivery. Without RESEND_API_KEY the e-mail body is only written to the log.
RESEND_API_KEY=
LEAD_EMAIL_FROM=lead@epersona.pl
LEAD_EMAIL=twoj-adres@example.com
COMPANY_NAME=Persona
