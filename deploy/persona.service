# Persona — lead-capture advisor builder
#
#   sudo cp deploy/persona.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now persona
#
[Unit]
Description=Persona (lead-capture advisor builder)
Documentation=https://github.com/Web-Dev93/Persona
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=persona
Group=persona
WorkingDirectory=/var/www/persona

# Secrets and settings live outside the checkout so a deploy never overwrites them.
EnvironmentFile=/etc/persona/persona.env

ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=persona

# The process only ever needs to write to its own state directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/persona
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
