{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "lint": "tsc --build",
    "build:libs": "tsc --build",
    "build:frontend": "npm --workspace=@workspace/lead-catcher run build",
    "build:server": "npm --workspace=@workspace/api-server run build",
    "build": "npm run build:libs && npm run build:frontend && npm run build:server",
    "dev": "npm --workspace=@workspace/api-server run dev",
    "start": "node artifacts/api-server/dist/index.mjs"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "openai": "^4.85.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
